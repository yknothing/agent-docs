{
  "name": "agent-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Agent docs repository with Feishu CLI integration",
  "scripts": {
    "feishu:install": "npx @larksuite/cli@latest install",
    "feishu:config": "lark-cli config init --new",
    "feishu:auth": "bash scripts/auth-feishu-cli.sh",
    "feishu:auth:proxyless": "LARK_CLI_NO_PROXY=1 ALL_PROXY= HTTPS_PROXY= HTTP_PROXY= NO_PROXY= bash scripts/auth-feishu-cli.sh --recommend",
    "feishu:auth:device": "bash scripts/auth-feishu-cli.sh --recommend --no-wait",
    "feishu:auth:device:proxyless": "LARK_CLI_NO_PROXY=1 ALL_PROXY= HTTPS_PROXY= HTTP_PROXY= NO_PROXY= bash scripts/auth-feishu-cli.sh --recommend --no-wait",
    "feishu:status": "lark-cli auth status",
    "feishu:check": "bash scripts/check-feishu-cli.sh",
    "feishu:check:auth": "bash scripts/check-feishu-cli-auth.sh",
    "feishu:check:full": "bash scripts/check-feishu-cli.sh && bash scripts/check-feishu-cli-auth.sh",
    "feishu:doctor": "lark-cli doctor",
    "feishu:setup": "bash scripts/setup-feishu-cli.sh",
    "anthropic:discover": "python3 scripts/anthropic_content_pipeline.py --discover-only --output-root artifacts/anthropic-discovery",
    "anthropic:crawl": "python3 scripts/anthropic_content_pipeline.py --batch-size 20 --output-root artifacts/anthropic-content",
    "anthropic:crawl:smoke": "python3 scripts/anthropic_content_pipeline.py --max-items 5 --batch-size 5 --no-qa --translate-mode off --output-root artifacts/anthropic-content-smoke",
    "anthropic:commit": "python3 scripts/anthropic_content_pipeline.py --batch-size 20 --commit --output-root artifacts/anthropic-content",
    "anthropic:sync-dryrun": "python3 scripts/anthropic_content_pipeline.py --batch-size 20 --sync-feishu --output-root artifacts/anthropic-content",
    "anthropic:sync": "python3 scripts/anthropic_content_pipeline.py --batch-size 20 --sync-feishu --execute-feishu --output-root artifacts/anthropic-content"
  }
}
